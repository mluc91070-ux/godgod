# GODGOD configuration.
# Copy to .env and fill in only what you actually have.
# The application runs fully in demo mode with none of these set.

# --- modes ---------------------------------------------------------------
DEMO_MODE=true
ENVIRONMENT=local
# 0 read-only | 1 research+draft (default) | 2 approval+publish | 3 limited auto | 4 future
AUTONOMY_LEVEL=1
# draft | approval | publish. V1 never publishes automatically.
X_MODE=draft
EXTERNAL_CONTENT_IS_UNTRUSTED=true

# --- database ------------------------------------------------------------
# Local/demo default (no server required):
DATABASE_URL=sqlite+aiosqlite:///./godgod.db
# Production target (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+psycopg://godgod:godgod@localhost:5432/godgod
DATABASE_ECHO=false

# --- api -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Required to enable draft approval endpoints. Unset means they stay disabled.
ADMIN_TOKEN=

# --- providers (leave empty in demo mode) --------------------------------
SOLANA_RPC_URL=
SOLANA_WS_URL=
X_BEARER_TOKEN=
# Recent search is not in every X access tier. With a token that lacks it the
# provider says so rather than reporting an empty result.
X_SEARCH_TERMS=solana meme coin,pump.fun
X_MAX_POSTS_PER_RUN=100
X_MIN_LIKES=0
X_EXCLUDE_REPOSTS=true
# Posting needs user context: the bearer token above can only read.
# Set X_MODE=publish as well, or nothing goes out.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MIN_MINUTES_BETWEEN_POSTS=45
ANTHROPIC_API_KEY=

# --- model routing -------------------------------------------------------
# Never hard-code model names in code; they are read from here.
MODEL_FAST=
MODEL_REASONING=
MODEL_WRITER=
MODEL_CRITIC=

# --- memory --------------------------------------------------------------
# local = deterministic hashing embedder, no API key, lexical (not semantic).
# none  = vectors disabled; memory search falls back to substring matching.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_DIM=1536
# Rows scanned by the Python cosine fallback (PostgreSQL uses pgvector instead).
MEMORY_SCAN_LIMIT=5000
# Minimum cosine for a hit. Measured against the embedder — see config.py.
MEMORY_SIMILARITY_THRESHOLD=0.12

# --- observation pipeline ------------------------------------------------
OBSERVATION_WINDOW_HOURS=6
OBSERVATION_MIN_SNAPSHOTS=6
OBSERVATION_MIN_LIQUIDITY_USD=5000
OBSERVATION_MIN_HOLDERS=50
# A candidate with no anomaly is only recorded if it is at least this novel.
OBSERVATION_NOVELTY_FLOOR=0.55
# Below this importance an observation is stored but not written to memory.
OBSERVATION_MEMORY_IMPORTANCE_FLOOR=0.5
# Same subject + same anomaly type inside this window counts as a duplicate.
OBSERVATION_COOLDOWN_MINUTES=180

# --- cost control --------------------------------------------------------
LLM_DAILY_BUDGET_USD=3.0
MEMORY_RETRIEVAL_LIMIT=20

# --- frontend ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
