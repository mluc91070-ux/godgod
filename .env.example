# GODGOD configuration.
# Copy to .env and fill in only what you actually have.
# The application runs fully in demo mode with none of these set.

# --- modes ---------------------------------------------------------------
DEMO_MODE=true
ENVIRONMENT=local
# 0 read-only | 1 research+draft (default) | 2 approval+publish | 3 limited auto | 4 future
AUTONOMY_LEVEL=1
# draft | approval | publish. V1 never publishes automatically.
X_MODE=draft
EXTERNAL_CONTENT_IS_UNTRUSTED=true

# --- database ------------------------------------------------------------
# Local/demo default (no server required):
DATABASE_URL=sqlite+aiosqlite:///./godgod.db
# Production target (PostgreSQL + pgvector):
# DATABASE_URL=postgresql+psycopg://godgod:godgod@localhost:5432/godgod
DATABASE_ECHO=false

# --- api -----------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000
# Required to enable draft approval endpoints. Unset means they stay disabled.
ADMIN_TOKEN=

# --- providers (leave empty in demo mode) --------------------------------
SOLANA_RPC_URL=
SOLANA_WS_URL=
X_BEARER_TOKEN=
# Recent search is not in every X access tier. With a token that lacks it the
# provider says so rather than reporting an empty result.
X_SEARCH_TERMS=solana meme coin,pump.fun
X_MAX_POSTS_PER_RUN=100
X_MIN_LIKES=0
X_EXCLUDE_REPOSTS=true
# Posting needs user context: the bearer token above can only read.
# Set X_MODE=publish as well, or nothing goes out.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_MIN_MINUTES_BETWEEN_POSTS=45
ANTHROPIC_API_KEY=

# --- model routing -------------------------------------------------------
# Never hard-code model names in code; they are read from here.
MODEL_FAST=
MODEL_REASONING=
MODEL_WRITER=
MODEL_CRITIC=

# --- memory --------------------------------------------------------------
# local = deterministic hashing embedder, no API key, lexical (not semantic).
# none  = vectors disabled; memory search falls back to substring matching.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=local-hashing-v1
EMBEDDING_DIM=1536
# Rows scanned by the Python cosine fallback (PostgreSQL uses pgvector instead).
MEMORY_SCAN_LIMIT=5000
# Minimum cosine for a hit. Measured against the embedder — see config.py.
MEMORY_SIMILARITY_THRESHOLD=0.12

# --- observation pipeline ------------------------------------------------
OBSERVATION_WINDOW_HOURS=6
OBSERVATION_MIN_SNAPSHOTS=6
OBSERVATION_MIN_LIQUIDITY_USD=5000
OBSERVATION_MIN_HOLDERS=50
# A candidate with no anomaly is only recorded if it is at least this novel.
OBSERVATION_NOVELTY_FLOOR=0.55
# Below this importance an observation is stored but not written to memory.
OBSERVATION_MEMORY_IMPORTANCE_FLOOR=0.5
# Same subject + same anomaly type inside this window counts as a duplicate.
OBSERVATION_COOLDOWN_MINUTES=180

# --- cost control --------------------------------------------------------
LLM_DAILY_BUDGET_USD=3.0
MEMORY_RETRIEVAL_LIMIT=20

# --- frontend ------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- the second chain: a node, and the launch contracts on it -------------
# Read-only JSON-RPC. Four methods are used and none of them can sign or send.
# The url decides which chain; nothing in the code names one.
EVM_RPC_URL=
# Which Token.chain the reads describe, and the id the node must report. Set
# the id and a node pointed at the wrong network refuses loudly instead of
# quietly writing another chain's tokens into this one's rows.
EVM_CHAIN=robinhood
EVM_CHAIN_ID=
# Launch contracts, comma-separated. Empty means no curve state is read and no
# token on this chain is marked migrated — which is the honest default.
#
# Do not take these from a blog post. Three addresses published as "the"
# factory for this launchpad were checked against the chain and none of them
# emitted the launch event. The way to find the real ones is to ask the chain:
# eth_getLogs filtered on the event topic with no address at all, then read
# which contracts emitted it. Two did, and only one of them answers the status
# call — the other reverts, which is recorded as unreadable, never as "no".
EVM_LAUNCHPAD_FACTORIES=
# Measured limits of the public endpoint, not preferences: it refuses a log
# range wider than 2000 blocks, rate-limits bursts with 429, and times out on
# repeated wide queries.
EVM_LOG_CHUNK_BLOCKS=2000
EVM_SCAN_MAX_BLOCKS_PER_RUN=6000
EVM_SCAN_START_BLOCKS_BACK=20000
EVM_LAUNCHPAD_MAX_CALLS=25
EVM_RECHECK_HOURS=6

# --- the watchlist: tokens named by hand ---------------------------------
# `chain:address`, comma-separated. Measured every run whatever the feed is
# doing, stored under their own frame, and DROPPED from every research dataset
# by name — the list was written after seeing which tokens did well, so every
# entry is a survivor and a rate computed over them says nothing about tokens.
#
# The fourteen below were checked against the market source before being
# written here: all fourteen resolve on chain robinhood and their symbols
# match. Their measured market caps sat inside the ranges they came with,
# except one that was well above and one slightly above — which is the reason
# the caps are not stored anywhere. The system measures; a list supplies
# addresses and nothing else.
CHAIN_WATCHLIST=robinhood:0x39dBED3a2bd333467115dE45665cC57F813C4571,robinhood:0x020bfC650A365f8BB26819deAAbF3E21291018b4,robinhood:0x2E8c31162b855A2ffa90F6F8634643Ad6F111e18,robinhood:0x98096d17e191B3dA1d5f99a6D7b3584351b11E18,robinhood:0x5Cb6F181081301b44905F3ae15419112ecaBd8A6,robinhood:0x7FE995a80075dF3Dc8Ae11A9b82c7FE4202CD87f,robinhood:0xe934e36a439c94017b64a3fece66af12099abf50,robinhood:0x45242320dbb855eea8fd36804c6487e10e97fcf9,robinhood:0xd5f1afea47b1a9eab414d2ee740cf1d6d039e725,robinhood:0x18e674231a58c239dc7daedcffe15ec3a24cff5c,robinhood:0x5173d45a1191ee33cbb7d8c7e65f21b04ed54802,robinhood:0xD7321801CAae694090694Ff55A9323139F043B88,robinhood:0x8e62F281f282686fCa6dCB39288069a93fC23F1c,robinhood:0xded852De9fe9bA9b6f27f39e8e81CF851A5C79cc
